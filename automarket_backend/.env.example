# Copie para .env (local) ou cadastre no painel do Render. Sem valores reais aqui.
DATABASE_URL=postgresql://USER:SENHA@HOST/DB?sslmode=require
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=7d
PORT=3000

# Origens do front (lista separada por vírgula). SUBSTITUI o padrão de dev
# (http://localhost:5173) — em produção, só a URL da Vercel.
CORS_ORIGINS=http://localhost:5173

# true = POST/PUT/PATCH/DELETE respondem 403 {"code":"READ_ONLY"} (demo).
# Exceções: login, revelar faturamento e contato WhatsApp público.
READ_ONLY=false

# Cloudflare R2 (fotos de veículos)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# Só para `npm run seed:demo`
DEMO_PASSWORD=
# DEMO_MANAGER_PASSWORD=
# DEMO_EMAIL=demo@automarket.demo
# DEMO_IMAGE_BASE_URL=https://cdn.exemplo.com/demo   # <base>/1.jpg … 12.jpg

# Render free (512 MB)
# NODE_OPTIONS=--max-old-space-size=384
