generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TipoVeiculo {
  BUGGY
  CAMINHAO_LEVE
  CONVERSIVEL
  COUPE
  PERUA
  VAN_UTILITARIO
  SUV
  HATCH
  SEDAN
  ELETRICO
  PICKUP
}

enum Cambio {
  AUTOMATICO
  MANUAL
  SEMI_AUTOMATICO
  AUTOMATIZADO
}

enum Direcao {
  HIDRAULICA
  ELETRO_HIDRAULICA
  MECANICA
  ELETRICA
}

enum Combustivel {
  ALCOOL
  GASOLINA
  FLEX
  DIESEL
  GNV
  HIBRIDO
  ELETRICO
}

enum Cor {
  AMARELO
  AZUL
  BRANCO
  CINZA
  LARANJA
  PRETO
  PRATA
  VERDE
  VERMELHO
  OUTRO
}

enum StatusVeiculo {
  DISPONIVEL
  RESERVADO
  VENDIDO
}

