model Endereco {
  id Int @id @default(autoincrement())

  cep    String? @db.VarChar(9)
  rua    String? @db.VarChar(200)
  numero String? @db.VarChar(20)
  bairro String? @db.VarChar(100)
  cidade String  @db.VarChar(100)
  estado String  @db.VarChar(2)

  lojaId Int  @unique
  loja   Loja @relation(fields: [lojaId], references: [id], onDelete: Cascade)

  @@map("enderecos")
}

model Loja {
  id     Int     @id @default(autoincrement())
  nome   String  @db.VarChar(150)
  slug   String  @unique @db.VarChar(100)
  logo   String? @db.VarChar(500)
  banner String? @db.VarChar(500)

  // cores de marca da loja, aplicadas como CSS custom properties no
  // catálogo público (nunca no painel admin) — VarChar(7) porque um hex é
  // sempre #RRGGBB. Nullable: sem customização, usa os defaults do
  // catalog-theme.css
  corPrimaria   String? @db.VarChar(7)
  corSecundaria String? @db.VarChar(7)

  email               String  @unique @db.VarChar(150)
  telefone            String? @db.VarChar(20)
  whatsapp            String? @db.VarChar(20)
  passwordHash        String  @db.VarChar(255)
  managerPasswordHash String  @db.VarChar(255)

  // horário de funcionamento único pra todos os dias úteis (String em vez de
  // Time do Postgres: só é exibido no footer público, nunca usado em cálculo
  // — evita complicação de timezone/parsing no Prisma à toa)
  horarioAbertura   String? @db.VarChar(5)
  horarioFechamento String? @db.VarChar(5)

  facebookUrl  String? @db.VarChar(500)
  instagramUrl String? @db.VarChar(500)
  youtubeUrl   String? @db.VarChar(500)

  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  endereco           Endereco?
  vendedores         Vendedor[]
  veiculos           Veiculo[]
  veiculosArquivados VeiculoArquivado[]
  contatosWhatsapp   ContatoWhatsapp[]

  @@index([slug])
  @@map("lojas")
}

model Vendedor {
  id       Int     @id @default(autoincrement())
  nome     String  @db.VarChar(150)
  fotoUrl  String? @db.VarChar(500)
  whatsapp String  @db.VarChar(20)
  ativo    Boolean @default(true)

  lojaId Int
  loja   Loja @relation(fields: [lojaId], references: [id], onDelete: Cascade)

  contatos         ContatoWhatsapp[]
  veiculosVendidos Veiculo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lojaId])
  @@map("vendedores")
}

model Veiculo {
  id Int @id @default(autoincrement())

  lojaId Int
  loja   Loja @relation(fields: [lojaId], references: [id], onDelete: Cascade)

  // marca/modelo vêm de um <select> populado pela FIPE API no cadastro,
  // por isso ficam como String (padronizados na UI, não no banco).
  // Os IDs FIPE ficam guardados pra permitir reconsulta de preço no futuro.
  marca        String @db.VarChar(100)
  marcaFipeId  Int?
  modelo       String @db.VarChar(150)
  modeloFipeId Int?

  anoFabricacao Int
  anoModelo     Int
  tipoVeiculo   TipoVeiculo
  cambio        Cambio
  portas        Int
  combustivel   Combustivel
  direcao       Direcao
  potenciaMotor String      @db.VarChar(50)
  cor           Cor
  quilometragem Int
  descricao     String      @db.Text
  preco         Float

  // itens de série: lista fixa do sistema, muda raramente (3-6 meses),
  // por isso array de enum em vez de tabela relacional
  itens ItemVeiculo[]

  // opcionais
  precoPromocional          Float?
  documentacaoRegularizacao String? @db.VarChar(200)
  conservacaoGarantia       String? @db.VarChar(200)
  aceitaTroca               Boolean @default(false)
  aceitaFinanciamento       Boolean @default(false)

  status        StatusVeiculo @default(DISPONIVEL)
  visualizacoes Int           @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  dataVenda DateTime?

  // soft delete: "Excluir" no painel só marca ativo=false e carimba
  // excluidoEm. O veículo continua no banco (fora de estoque/catálogo) até
  // o cron de arquivamento (ver VeiculoArquivado) apagá-lo de vez, 30 dias
  // depois — dando uma janela pra reativar por engano.
  ativo      Boolean   @default(true)
  excluidoEm DateTime?

  // preenchido só quando o veículo é vendido (ver Veiculo.vender)
  vendedorId Int?
  vendedor   Vendedor? @relation(fields: [vendedorId], references: [id])

  imagens  VeiculoImagem[]
  contatos ContatoWhatsapp[]

  @@index([lojaId])
  @@index([lojaId, status])
  @@index([marca, modelo])
  @@map("veiculos")
}

// Retrato congelado de um Veiculo no momento em que o cron de arquivamento
// o apaga de vez (30 dias após o soft delete) — só os campos que as métricas
// do Dashboard realmente somam/contam (ver DashboardService), não o veículo
// inteiro (sem descrição, itens, ficha técnica: isso não tem valor histórico
// depois que o anúncio não existe mais). `vendedorId` é só um número, sem
// relação/FK — é referência histórica, não deve travar a exclusão de um
// vendedor nem ser afetada por ela.
model VeiculoArquivado {
  id                Int @id @default(autoincrement())
  veiculoIdOriginal Int

  lojaId Int
  loja   Loja @relation(fields: [lojaId], references: [id], onDelete: Cascade)

  marca         String
  modelo        String
  anoModelo     Int
  preco         Float
  status        StatusVeiculo
  visualizacoes Int
  totalContatos Int
  vendedorId    Int?

  criadoEm    DateTime // Veiculo.createdAt original
  dataVenda   DateTime?
  excluidoEm  DateTime // quando o soft delete aconteceu
  arquivadoEm DateTime  @default(now())

  @@index([lojaId])
  @@index([lojaId, status])
  @@map("veiculos_arquivados")
}

model VeiculoImagem {
  id    Int     @id @default(autoincrement())
  url   String  @db.VarChar(500)
  ordem Int     @default(0)
  capa  Boolean @default(false)

  veiculoId Int
  veiculo   Veiculo @relation(fields: [veiculoId], references: [id], onDelete: Cascade)

  @@index([veiculoId])
  @@map("veiculo_imagens")
}

model ContatoWhatsapp {
  id Int @id @default(autoincrement())

  // Guardado direto aqui (não só via veiculo.lojaId) porque veiculoId pode
  // virar null quando o veículo é arquivado/apagado (ver VeiculoArquivado) —
  // sem isso, o histórico de contatos de um veículo já excluído ficaria
  // impossível de filtrar por loja, quebrando conversão/ranking do Dashboard
  // pra qualquer período que inclua um veículo já apagado.
  lojaId Int
  loja   Loja @relation(fields: [lojaId], references: [id], onDelete: Cascade)

  // Opcional e SetNull (não Cascade): o evento de contato é histórico
  // imutável — sobrevive à exclusão definitiva do veículo, só perde a
  // referência de qual veículo era.
  veiculoId Int?
  veiculo   Veiculo? @relation(fields: [veiculoId], references: [id], onDelete: SetNull)

  vendedorId Int
  vendedor   Vendedor @relation(fields: [vendedorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([lojaId])
  @@index([veiculoId])
  @@index([vendedorId])
  @@map("contatos_whatsapp")
}
