  ALERTA_TRAFEGO_CRUZADO_TRASEIRO
  CONTROLE_ESTABILIDADE
  CONTROLE_TRACAO
  ASSISTENTE_PARTIDA_RAMPA
  ASSISTENTE_DESCIDA_RAMPA
  SENSOR_FADIGA_MOTORISTA
  RECONHECIMENTO_PLACAS_TRANSITO
  FAROL_ALTO_AUTOMATICO
  ESTACIONAMENTO_AUTOMATICO

